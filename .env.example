# Required for OpenRouter chat. Keep this secret; never put it in public/ or frontend JS.
OPENROUTER_API_KEY=

# Optional Groq provider. Only models listed in GROQ_MODELS are exposed.
GROQ_API_KEY=
GROQ_MODELS=

# Optional: maximum messages per IP per 10-minute window (per serverless instance).
RATE_LIMIT_MAX=20
# Optional Mistral provider. Use only model IDs enabled for your account.
MISTRAL_API_KEY=
MISTRAL_MODELS=

# Optional Cloudflare Workers AI OpenAI-compatible endpoint.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CLOUDFLARE_MODELS=
